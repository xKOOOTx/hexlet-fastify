<form action="/users/new" method="POST" class="w-25">
    <div class="mb-3">
        <label for="name" class="form-label">Имя пользователя*</label>
        <input id="name" name="name" value="<%= it.name ?? ''%>" class="form-control" required placeholder="Введите имя пользователя" />
    </div>
    <div class="mb-3">
        <label for="email" class="form-label">Email*</label>
        <input id="email" name="email" value="<%= it.email ?? ''%>" class="form-control" required placeholder="Введите email" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Пароль</label>
        <input id="password" name="password" type="password" value="<%= it.password ?? ''%>" class="form-control" placeholder="Придумайте пароль" />
    </div>
    <div class="mb-3">
        <label for="passwordConfirmation" class="form-label">Повторите пароль</label>
        <input id="passwordConfirmation" name="passwordConfirmation" type="password" value="<%= it.passwordConfirmation ?? ''%>" class="form-control" placeholder="Повторите пароль" />
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>
<% if (it.message) { %>
    <p class="text-danger"><%= it.message %></p>
<% } %>
<% if (it.error) { %>
    <p class="text-danger"><%= it.error.message %></p>
<% } %>