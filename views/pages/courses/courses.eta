<div class="d-flex justify-content-between">
    <form action="<%= it.route('courses')%>" method="GET" class="w-25">
        <div class="mb-3">
            <label for="searchName" class="from-label">Поиск по наименованию</label>
            <input id="searchName" name="name" class="form-control" value="<%= it.name ?? '' %>" placeholder="Введите наименование курса"/>
        </div>
        <div class="mb-3">
            <label for="searchDescription" class="from-label">Поиск по описанию</label>
            <input id="searchDescription" name="description" class="form-control" value="<%= it.description ?? '' %>" placeholder="Введите описание курса"/>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Поиск</button>
            <a href="<%= it.route('courses')%>" class="btn btn-secondary">Сброс</a>
        </div>
    </form>
    <div class="d-flex align-items-end mb-3">
        <a href="<%= it.route('newCourseForm')%>" class="btn btn-primary">Добавить курс</a>
    </div>
</div>
<table class="table table-hover table-bordered table-dark">
    <thead>
        <tr>
            <th scope="col">id</th>
            <th scope="col">Наименование</th>
            <th scope="col">Описание</th>
        </tr>
    </thead>
    <tbody>
        <% if (it.courses.length === 0) { %>
            <tr>
                <th scope="row"></th>
                <td>Нет данных</td>
                <td></td>
            </tr>
        <% } %>
        <% it.courses.forEach(course => { %>
            <tr>
                <th scope="row">
                    <%= course.id %>
                </th>
                <td>
                    <a href="<%= it.route('course', {id: course.id})%>"><%= course.name%></a>
                    
                </td>
                <td>
                    <%= course.description%>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
<% if (it.courses.length > 0) { %>
    <p>Всего курсов: <%= it.courses.length %></p>
<% } %>