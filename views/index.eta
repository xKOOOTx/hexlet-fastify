<h1>Главная</h1>
<% if (!it.visited) { %> Это сообщение показывается только один раз. Если
      вы хотите увидеть его снова, сотрите куки <% } %>

<% Object.entries(it.messages).forEach(([type, messages]) => { %>
    <% messages.forEach((message) => { %>
        <div class="alert alert-<%= type %>">
            <%= message %>
        </div>
    <% }) %>
<% }) %>